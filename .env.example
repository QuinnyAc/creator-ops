# Runtime
APP_ENV=development

# PostgreSQL
POSTGRES_DB=creator_ops
POSTGRES_USER=creator_ops
POSTGRES_PASSWORD=creator_ops
POSTGRES_PORT=5432

# API
API_PORT=8000
DATABASE_URL=postgresql+psycopg://creator_ops:creator_ops@localhost:5432/creator_ops
CORS_ORIGINS=http://localhost:3000
ALLOW_DEV_USER_FALLBACK=true
JWT_SECRET_KEY=development-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
