# PostgreSQL
POSTGRES_DB=creator_ops
POSTGRES_USER=creator_ops
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Public ports used by docker-compose.prod.yml
WEB_PORT=3000
API_PORT=8000
API_WORKERS=2

# API security
APP_ENV=production
ALLOW_DEV_USER_FALLBACK=false
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Browser origins / public URLs
# Use your real HTTPS frontend origin in production.
CORS_ORIGINS=https://creator.example.com
PUBLIC_WEB_URL=https://creator.example.com
# NEXT_PUBLIC_* values are embedded into the Next.js browser bundle at image build time.
NEXT_PUBLIC_API_URL=https://api.creator.example.com
NEXT_PUBLIC_REQUIRE_AUTH=true

# Bilibili Open Platform
BILIBILI_CLIENT_ID=
BILIBILI_APP_SECRET=
